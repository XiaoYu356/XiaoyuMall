"""FAQ 知识库 v3 构建脚本（Task 5）。

运行方式（cwd=ai-service）：
    ai-service\\.venv\\Scripts\\python.exe -m scripts.build_faq_index

流程（设计文档 docs/ai-service-redesign-v3.md §13）：
1. 只读导入种子 scripts/faq_seed.py（39 条，2026-10 从 19 条扩充）
2. 每条种子调快速模型（json_mode）生成 3 条 similar_questions；
   单条失败回退人工兜底 FALLBACK_SIMILAR 并告警，不中断；
   与兜底问法合并去重（丢弃与原问题相同的，上限 5 条）
3. 每条 embed_texts([question] + similar)：question 向量存 question_vector
   （similar 仅参与 BM25 召回，本版不存向量，见 §13.2 要点）
4. ensure_faq_index_v3(recreate=True) 重建 mall_faq_v3 → bulk 导入
   （字段以 bulk_index_faq_v3 契约为准：question/similar_questions/answer/
   category/tags/version/question_vector；ES _id 自动生成，search_faq_v3
   返回的 id 即该 _id）
5. switch_faq_alias() 原子切换 alias mall_faq → mall_faq_v3
6. 冒烟：search_faq_v3("退货政策") 打印 top3 并断言非空

幂等：每次先删 mall_faq_v3 再重建，可重复执行且结果一致。
"""
import asyncio
import json
import logging
import sys

import httpx
from langchain_openai import ChatOpenAI

from app.core.config import settings
from app.core.embeddings import embed_text, embed_texts
from app.core.es_client import (
    bulk_index_faq_v3,
    ensure_faq_index_v3,
    search_faq_v3,
    switch_faq_alias,
)
from scripts.faq_seed import FAQ_ITEMS

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(name)s %(message)s")
logger = logging.getLogger("build_faq_index")

